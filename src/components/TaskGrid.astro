---
/*
   The six things most readers come to the home page for, as task cards.
   Each card is one link with a line icon, a title, and one short line.
   Two columns on phones, three on desktop.

   Icons come from src/lib/glyphs.ts through Icon.astro. A task links only
   to a page that exists.

   Styles live in pages.css. The list opts out of Starlight's markdown
   styles, since it sits inside the home page's markdown body.
*/
import type { GlyphName } from '../lib/glyphs';
import Icon from './Icon.astro';

interface Task {
	title: string;
	line: string;
	href: string;
	glyph: GlyphName;
}

const tasks: Task[] = [
	{ title: 'Where to train', line: 'Party routes. Help test them.', href: '/leveling/', glyph: 'flag' },
	{
		title: 'Job advancement',
		line: 'What changed for each class, skill by skill.',
		href: '/classes/warrior/',
		glyph: 'podium',
	},
	{ title: 'Quests', line: 'Who gives them, and what comes next.', href: '/library/?type=quest', glyph: 'scroll' },
	{ title: 'Library', line: 'Every monster, item, map, NPC, quest, and shop.', href: '/library/', glyph: 'monster' },
	{
		title: 'Crafting',
		line: 'Professions and the new systems, explained.',
		href: '/economy/crafting/',
		glyph: 'hammer',
	},
	{ title: 'What changed', line: 'Values that moved between builds.', href: '/changes/', glyph: 'arrows' },
];
---

<ul class="task-grid not-content">
	{
		tasks.map((task) => (
			<li class="task-grid__item">
				<a class="task-grid__card" href={task.href}>
					<span class="task-grid__icon">
						<Icon name={task.glyph} size={24} />
					</span>
					<span class="task-grid__title">{task.title}</span>
					<span class="task-grid__line">{task.line}</span>
				</a>
			</li>
		))
	}
</ul>
