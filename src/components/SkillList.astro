---
/*
   Lists the recorded skills for one class, grouped by nothing fancier than
   job order, with the Classic World difference front and center since that
   is what returning players come looking for.

   The list sits in a window. Four columns fit a desktop panel; under 480
   pixels each skill becomes its own labeled block, so nothing scrolls
   sideways. With no skills recorded, one invitation points at the class
   file on GitHub. A skill with no recorded difference reads Unknown.

   On a guide, the page can pass a markdown heading in the title slot,
   so the window shows up in the table of contents. The heading's text
   must match the window's id.
*/
import { getEntry } from 'astro:content';
import { editBaseUrl } from '../../site.config.mjs';
import Invitation from './Invitation.astro';
import Window from './Window.astro';

interface Props {
	classId: string;
}

const { classId } = Astro.props;
const classEntry = await getEntry('classes', classId);
if (!classEntry) throw new Error(`SkillList: no class "${classId}" in data/classes/`);

const skills = [...classEntry.data.skills].sort(
	(first, second) => first.job - second.job || first.name.localeCompare(second.name)
);

const classFileUrl = `${editBaseUrl}data/classes/${classId}.yaml`;
---

<Window title="Skills that changed" id="skills-that-changed">
	{Astro.slots.has('title') && <slot name="title" slot="title" />}
	{
		skills.length === 0 ? (
			<Invitation
				message={`No skills recorded yet for the ${classEntry.data.name}. Seen one in game? Send a correction from the link at the bottom of the page.`}
				href={classFileUrl}
				action="Add a skill"
			/>
		) : (
			<table class="data-table data-table--stack">
				<thead>
					<tr>
						<th scope="col">Skill</th>
						<th scope="col">Job</th>
						<th scope="col">Different in Classic World</th>
					</tr>
				</thead>
				<tbody>
					{skills.map((skill) => (
						<tr>
							<th scope="row">
								<span class="skill-name">
									{skill.icon && (
										<img src={`/sprites/${skill.icon.file}`} width="32" height="32" alt="" loading="lazy" decoding="async" />
									)}
									{skill.name}
								</span>
							</th>
							<td class="data-table__number" data-label="Job">
								{skill.job}
							</td>
							<td
								data-label="Different in Classic World"
								class:list={{ 'unknown-value': !skill.differs_from_original && !skill.summary }}
							>
								{skill.differs_from_original ?? skill.summary ?? 'Unknown'}
							</td>
						</tr>
					))}
				</tbody>
			</table>
		)
	}
</Window>
