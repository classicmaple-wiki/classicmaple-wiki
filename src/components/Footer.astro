---
/*
   Wraps the default Starlight footer (spec 0010). It stays short: one
   box asking readers to send a correction, then three items in one row:
   a link to play MapleStory Classic World on the official site, the Legal
   page with every disclaimer, license, and credit, and the builder
   credit. The full fine print lives on /legal/, one click away on every
   page.

   The correction link opens the Tally form from site.config.mjs with
   this page's address filled in, or the How to contribute page while no
   form is set. The footer sits on a soft band under a 1 pixel line.
*/
import Default from '@astrojs/starlight/components/Footer.astro';
import { builderName, builderUrl, correctionFormUrl, officialGameUrl, siteUrl } from '../../site.config.mjs';

const pageAddress = new URL(Astro.url.pathname, siteUrl).href;
const correctionUrl = correctionFormUrl
	? `${correctionFormUrl}?page=${encodeURIComponent(pageAddress)}`
	: '/contributing/';
---

<Default><slot /></Default>

<p class="site-contribute">
	Spotted something missing or wrong? <a href={correctionUrl}>Send a correction</a>. No account needed.
</p>

<nav class="site-credits" aria-label="Site">
	<a href={officialGameUrl} rel="noopener">Play MapleStory Classic World</a>
	<a href="/legal/">Legal and credits</a>
	<span>Built with love and care by <a href={builderUrl} rel="noopener">{builderName}</a></span>
</nav>

<style>
	.site-contribute {
		margin: var(--space-6) 0 0;
		padding: var(--space-4);
		background: var(--color-chip);
		border: 1px solid var(--color-line);
		border-radius: var(--radius-window);
		text-align: center;
		font-weight: 700;
		color: var(--color-ink);
	}

	.site-credits {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-2) var(--space-5);
		margin-top: var(--space-4);
		padding: var(--space-4);
		background: var(--color-stone);
		color: var(--color-stone-text);
		border-top: 1px solid var(--color-line);
		border-radius: var(--radius-window);
		font-size: var(--text-sm);
		text-align: center;
	}

	.site-credits a {
		color: var(--color-stone-link);
		font-weight: 700;
	}
</style>
