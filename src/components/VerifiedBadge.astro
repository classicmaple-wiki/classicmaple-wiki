---
/*
   Shows how much a reader can trust a number: official, confirmed in game,
   or unverified, plus the build it was seen in. When the entry has a
   source, the badge links to it.

   Drawn as an item tag chip: Silkscreen at 13 pixels in capitals, the
   badge colors from the tokens, a stepped left edge with a punched hole,
   and a tiny original pixel glyph before the word. The glyph is a check
   for official, an eye for confirmed in game, and a question mark for
   unverified. Each badge also carries its word, so color is never the
   only cue.
*/
import type { Verification } from '../../schemas/shared';

interface Props {
	verified: Verification;
}

const { verified } = Astro.props;

const labels = {
	official: 'Official',
	'in-game': 'Confirmed in game',
	unverified: 'Unverified',
} as const;

const variants = {
	official: 'chip--official',
	'in-game': 'chip--in-game',
	unverified: 'chip--unverified',
} as const;

const glyphPaths = {
	official: 'M6 1h1v1h-1zM5 2h2v1h-2zM0 3h1v1h-1zM4 3h2v1h-2zM0 4h2v1h-2zM3 4h2v1h-2zM1 5h3v1h-3zM2 6h1v1h-1z',
	'in-game': 'M2 1h3v1h-3zM1 2h1v1h-1zM5 2h1v1h-1zM0 3h1v1h-1zM3 3h1v1h-1zM6 3h1v1h-1zM1 4h1v1h-1zM5 4h1v1h-1zM2 5h3v1h-3z',
	unverified: 'M2 0h3v1h-3zM1 1h1v1h-1zM5 1h1v2h-1zM4 3h1v1h-1zM3 4h1v1h-1zM3 6h1v1h-1z',
} as const;

const text = verified.build ? `${labels[verified.status]} · ${verified.build}` : labels[verified.status];
const chipClass = `chip ${variants[verified.status]}`;
---

{
	verified.source ? (
		<a class={`${chipClass} chip--link`} href={verified.source} rel="noopener">
			<svg class="chip__glyph" width="9" height="9" viewBox="0 0 7 7" aria-hidden="true" focusable="false" shape-rendering="crispEdges">
				<path d={glyphPaths[verified.status]} />
			</svg>
			<span class="chip__text">{text}</span>
			<span class="sr-only">, see the source</span>
		</a>
	) : (
		<span class={chipClass}>
			<svg class="chip__glyph" width="9" height="9" viewBox="0 0 7 7" aria-hidden="true" focusable="false" shape-rendering="crispEdges">
				<path d={glyphPaths[verified.status]} />
			</svg>
			<span class="chip__text">{text}</span>
		</span>
	)
}
