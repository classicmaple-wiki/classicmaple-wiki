---
/*
   Shows how much a reader can trust a number: official, confirmed in game,
   or unverified, plus the build it was seen in. When the entry has a
   source, the badge links to it.

   Drawn as a small rounded pill (spec 0006) in the badge colors from the
   tokens, with a line icon before the word: a check for official, an eye
   for confirmed in game, and a question mark for unverified. Each badge
   also carries its word, so color is never the only cue. The build shows
   by its name from data/builds.yaml.
*/
import { getEntry } from 'astro:content';
import type { Verification } from '../../schemas/shared';
import Icon from './Icon.astro';

interface Props {
	verified: Verification;
}

const { verified } = Astro.props;

const labels = {
	official: 'Official',
	'in-game': 'Confirmed in game',
	unverified: 'Unverified',
} as const;

const variants = {
	official: 'chip--official',
	'in-game': 'chip--in-game',
	unverified: 'chip--unverified',
} as const;

const icons = { official: 'check', 'in-game': 'eye', unverified: 'question' } as const;

const buildName = verified.build ? ((await getEntry('builds', verified.build))?.data.name ?? verified.build) : undefined;
const text = buildName ? `${labels[verified.status]} · ${buildName}` : labels[verified.status];
const chipClass = `chip ${variants[verified.status]}`;
---

{
	verified.source ? (
		<a class={`${chipClass} chip--link`} href={verified.source} rel="noopener">
			<Icon name={icons[verified.status]} size={12} strokeWidth={2.6} class="chip__glyph" />
			<span class="chip__text">{text}</span>
			<span class="sr-only">, see the source</span>
		</a>
	) : (
		<span class={chipClass}>
			<Icon name={icons[verified.status]} size={12} strokeWidth={2.6} class="chip__glyph" />
			<span class="chip__text">{text}</span>
		</span>
	)
}
