---
/*
   Labeled rows for a stat block inside a window. Labels sit on the left in
   muted Nunito, values on the right in ink with tabular figures, and a
   dotted line runs between rows. Under 480 pixels each label stacks above
   its value, so nothing is squeezed on a phone.

   A missing, null, or empty value reads Unknown in muted italic, with no
   link. Contributing has one dedicated place, linked at the foot of every
   page. editUrl and subject are still accepted, so callers keep working.
*/

interface StatRow {
	label: string;
	value?: string | number | null;
	href?: string;
}

interface Props {
	rows: StatRow[];
	editUrl?: string;
	subject?: string;
}

const { rows } = Astro.props;

/*
   A value counts as known only when it has something to show. Zero is a
   real number and stays known.
*/
function isKnown(value: StatRow['value']): value is string | number {
	if (value === undefined || value === null) return false;
	return typeof value === 'number' || value.trim() !== '';
}

/*
   Numbers get thousands separators, so long HP values stay readable.
*/
function formatValue(value: string | number): string {
	return typeof value === 'number' ? value.toLocaleString('en-US') : value;
}

---

<dl class="stat-rows">
	{
		rows.map((row) => (
			<div class="stat-rows__row">
				<dt class="stat-rows__label">{row.label}</dt>
				<dd class="stat-rows__value">
					{isKnown(row.value) ? (
						row.href ? (
							<a href={row.href}>{formatValue(row.value)}</a>
						) : (
							formatValue(row.value)
						)
					) : (
						<span class="unknown-value">Unknown</span>
					)}
				</dd>
			</div>
		))
	}
</dl>
