---
/*
   Labeled rows for a stat block inside a window. Labels sit on the left in
   muted Nunito, values on the right in ink with tabular figures, and a
   dotted line runs between rows. Under 480 pixels each label stacks above
   its value, so nothing is squeezed on a phone.

   A missing, null, or empty value reads Unknown in muted italic. When
   every row is Unknown and an edit link is given, one invitation opens the
   block instead of a link on every row. When only some rows are Unknown,
   each of those rows gets a small Add it link instead.
*/
import Invitation from './Invitation.astro';

interface StatRow {
	label: string;
	value?: string | number | null;
	href?: string;
}

interface Props {
	rows: StatRow[];
	editUrl?: string;
	subject?: string;
}

const { rows, editUrl, subject } = Astro.props;

/*
   A value counts as known only when it has something to show. Zero is a
   real number and stays known.
*/
function isKnown(value: StatRow['value']): value is string | number {
	if (value === undefined || value === null) return false;
	return typeof value === 'number' || value.trim() !== '';
}

/*
   Numbers get thousands separators, so long HP values stay readable.
*/
function formatValue(value: string | number): string {
	return typeof value === 'number' ? value.toLocaleString('en-US') : value;
}

const everyRowUnknown = rows.length > 0 && rows.every((row) => !isKnown(row.value));
const showsInvitation = everyRowUnknown && editUrl !== undefined;
const showsRowLinks = !everyRowUnknown && editUrl !== undefined;
const invitationMessage = `Nobody has recorded ${subject ?? 'these values'} yet. Seen it in game? Bring a screenshot.`;
---

{showsInvitation && editUrl && <Invitation message={invitationMessage} href={editUrl} action="Add the first value" />}

<dl class="stat-rows">
	{
		rows.map((row) => (
			<div class="stat-rows__row">
				<dt class="stat-rows__label">{row.label}</dt>
				<dd class="stat-rows__value">
					{isKnown(row.value) ? (
						row.href ? (
							<a href={row.href}>{formatValue(row.value)}</a>
						) : (
							formatValue(row.value)
						)
					) : (
						<>
							<span class="unknown-value">Unknown</span>
							{showsRowLinks && (
								<a class="stat-rows__add" href={editUrl} rel="noopener">
									Add it<span class="sr-only"> ({row.label})</span>
								</a>
							)}
						</>
					)}
				</dd>
			</div>
		))
	}
</dl>
