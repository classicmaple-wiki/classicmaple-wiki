---
/*
   The note a window shows when it has nothing to show yet. Since
   2026-10-15 it is a plain muted line with no button: contributing has
   one dedicated place, the How to contribute page, linked at the foot of
   every page. The action and href props are kept so existing callers
   still compile, and are not shown.
*/
interface Props {
	message: string;
	href?: string;
	action?: string;
}

const { message } = Astro.props;
---

<p class="window__note">{message}</p>
