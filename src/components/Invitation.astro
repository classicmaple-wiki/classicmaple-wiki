---
/*
   The one call to action a window shows when it has no data at all. It
   replaces a row of separate Add it links with a single dashed box: a
   small pixel question mark, one short message, and one button cut like
   an old client button. The button goes straight to the file to edit.
*/
interface Props {
	message: string;
	href: string;
	action: string;
}

const { message, href, action } = Astro.props;
---

<div class="invitation">
	<svg
		class="invitation__glyph"
		width="18"
		height="18"
		viewBox="0 0 7 7"
		aria-hidden="true"
		focusable="false"
		shape-rendering="crispEdges"
	>
		<path d="M2 0h3v1h-3zM1 1h1v1h-1zM5 1h1v2h-1zM4 3h1v1h-1zM3 4h1v1h-1zM3 6h1v1h-1z"></path>
	</svg>
	<div class="invitation__content">
		<p class="invitation__message">{message}</p>
		<a class="client-button invitation__action" href={href} rel="noopener">{action}</a>
	</div>
</div>
