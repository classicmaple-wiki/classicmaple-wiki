---
/*
   A short fact box for one game system, read from data/systems/.

   The facts sit in a window as stat rows, which stack label over value on
   a phone. The status chip lives in the window footer, since a chip is
   not a stat. When every fact is missing, one invitation points at the
   system's file on GitHub.

   On a guide, the page can pass a markdown heading in the title slot,
   so the window shows up in the table of contents. The heading's text
   must match the window's id.
*/
import { getEntry } from 'astro:content';
import { editBaseUrl } from '../../site.config.mjs';
import StatRows from './StatRows.astro';
import Window from './Window.astro';

interface Props {
	systemId: string;
}

const { systemId } = Astro.props;
const systemEntry = await getEntry('systems', systemId);
if (!systemEntry) throw new Error(`SystemSummary: no system "${systemId}" in data/systems/`);

const system = systemEntry.data;
const systemFileUrl = `${editBaseUrl}data/systems/${systemId}.yaml`;
---

<Window title="At a glance" id="at-a-glance">
	{Astro.slots.has('title') && <slot name="title" slot="title" />}
	<StatRows
		rows={[
			{ label: 'Unlocks at level', value: system.required_level },
			{ label: 'Summary', value: system.summary },
		]}
		editUrl={systemFileUrl}
		subject="this system"
	/>
</Window>
