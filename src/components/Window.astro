---
/*
   The window frame from spec 0002, the signature component. Every boxed
   block on the site sits in one: a wooden title bar (spec 0003) with a 3
   pixel stripe in the page's mood rule, the title in heavy game text, and
   an optional build chip on the right. The body is a parchment panel. A footer strip appears only when the footer
   slot is used.

   The title is always a real heading, so the outline and the table of
   contents work. There are two ways to give it. Generated pages pass the
   title prop, and the window draws an h2, or an h3 when headingLevel asks
   for one, with the given id. Guides in MDX pass a markdown heading in
   the title slot instead, because Starlight only lists markdown headings
   in a guide's table of contents. The heading lands in the title bar and
   looks the same. Its id comes from its text, so the id given here must
   match it for the section label to work.

   Components that hold a window pass the slot through, so the slot can
   exist and still be empty. The window renders it first and falls back
   to the title prop when nothing came through. Without an id, a title
   prop heading gets an id made from the title, used only to label the
   section.

   All styling lives in src/styles/window.css as global rules, so markup
   from any page can reuse the same classes.
*/
interface Props {
	title?: string;
	id?: string;
	build?: string;
	headingLevel?: 2 | 3;
}

const { title, id, build, headingLevel = 2 } = Astro.props;

const slottedTitle = Astro.slots.has('title') ? (await Astro.slots.render('title')).trim() : '';
const hasTitleSlot = slottedTitle !== '';
const titleSlug = (title ?? '')
	.toLowerCase()
	.replace(/[^a-z0-9]+/g, '-')
	.replace(/^-+|-+$/g, '');
const headingIdentifier = id ?? (hasTitleSlot ? undefined : `window-${titleSlug || 'untitled'}`);
const HeadingTag = `h${headingLevel}` as const;
const hasFooter = Astro.slots.has('footer');
---

<section class="window" aria-labelledby={headingIdentifier}>
	<div class="window__title-bar">
		{hasTitleSlot ? <Fragment set:html={slottedTitle} /> : <HeadingTag class="window__title" id={headingIdentifier}>{title}</HeadingTag>}
		{build && <span class="chip window__build">{build}</span>}
	</div>
	<div class="window__body">
		<slot />
	</div>
	{
		hasFooter && (
			<div class="window__footer">
				<slot name="footer" />
			</div>
		)
	}
</section>
