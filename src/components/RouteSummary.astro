---
/*
   The fact line at the top of a leveling route. It reads the frontmatter
   of the page it is placed on, so authors fill in the fields once. A route
   without "tested_in" is labeled Untested automatically.

   The facts sit in a window as stat rows, which stack label over value on
   a phone. The tested or untested chip lives in the window footer, cut
   like the status chips: green for tested, amber for an untested draft.

   On a guide, the page can pass a markdown heading in the title slot,
   so the window shows up in the table of contents. The heading's text
   must match the window's id.
*/
import StatRows from './StatRows.astro';
import Icon from './Icon.astro';
import Window from './Window.astro';

const { level_range, party_size, classes, tested_in } = Astro.locals.starlightRoute.entry.data;
const editUrl = Astro.locals.starlightRoute.editUrl?.href;

const classNames = classes?.map((className: string) => className.charAt(0).toUpperCase() + className.slice(1));
---

<Window title="Route at a glance" id="route-at-a-glance">
	{Astro.slots.has('title') && <slot name="title" slot="title" />}
	<StatRows
		rows={[
			{ label: 'Levels', value: level_range ? `Level ${level_range[0]} to ${level_range[1]}` : undefined },
			{ label: 'Party', value: party_size ? (party_size === 1 ? 'Solo' : `Party of ${party_size}`) : undefined },
			{ label: 'Classes', value: classNames && classNames.length > 0 ? classNames.join(', ') : undefined },
		]}
		editUrl={editUrl}
		subject="this route"
	/>
	<p class="window__status" slot="footer">
		{
			tested_in ? (
				<span class="chip chip--official">
					<Icon name="check" size={12} strokeWidth={2.6} class="chip__glyph" />
					<span class="chip__text">Tested in {tested_in}</span>
				</span>
			) : (
				<span class="chip chip--unverified">
					<Icon name="question" size={12} strokeWidth={2.6} class="chip__glyph" />
					<span class="chip__text">Untested draft</span>
				</span>
			)
		}
	</p>
</Window>
