---
/*
   One page per shop, generated from data/shops/ (spec 0005), in the same
   layout as the map pages. The Shop window gives the NPC who runs it, the
   map, and the region. Then the shopkeeper as a card with their sprite,
   and the stock as item cards, like a shop window in the game (spec
   0009). The page sits in the scene of the shop's town. Prices are left out until a player confirms
   them. Notes, the history, and the source credit follow.

   The History window appears only once the entry has a recorded change.
*/
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import { editBaseUrl } from '../../../site.config.mjs';
import ChangeLog from '../../components/ChangeLog.astro';
import SourceCredit from '../../components/SourceCredit.astro';
import StatRows from '../../components/StatRows.astro';
import LibraryCard from '../../components/LibraryCard.astro';
import Window from '../../components/Window.astro';
import { libraryCards } from '../../lib/library';
import { resolveMapScene } from '../../lib/scenes';

export async function getStaticPaths() {
	const shopEntries = await getCollection('shops');
	return shopEntries.map((shopEntry) => ({
		params: { id: shopEntry.data.id },
		props: { shop: shopEntry.data },
	}));
}

const { shop } = Astro.props;
const keeperMapId = (await getCollection('npcs')).find((npcEntry) => npcEntry.data.id === shop.npc)?.data.map;
const sceneMap = (await getCollection('maps')).find((mapEntry) => mapEntry.data.id === (shop.map ?? keeperMapId))?.data;
const resolved = await resolveMapScene(sceneMap ?? shop);
const editUrl = `${editBaseUrl}data/shops/${shop.id}.yaml`;
const keeper = (await getCollection('npcs')).find((npcEntry) => npcEntry.data.id === shop.npc)?.data;
const shopMap = (await getCollection('maps')).find((mapEntry) => mapEntry.data.id === shop.map)?.data;
const itemsById = new Map((await getCollection('items')).map((itemEntry) => [itemEntry.data.id, itemEntry.data]));
const stock = shop.items.flatMap((identifier) => itemsById.get(identifier) ?? []);
const allCards = await libraryCards();
const stockIds = new Set(stock.map((item) => item.id));
const stockCards = allCards.filter((card) => card.type === 'item' && stockIds.has(card.identifier));
const keeperCard = keeper ? allCards.find((card) => card.type === 'npc' && card.identifier === keeper.id) : undefined;

const statisticRows = [
	{ label: 'Run by', value: keeper?.name, href: keeper ? `/npcs/${keeper.id}/` : undefined },
	{ label: 'Map', value: shopMap?.name, href: shopMap ? `/maps/${shopMap.id}/` : undefined },
	{ label: 'Region', value: shop.region },
];

const headings = [
	{ depth: 2, slug: 'stats', text: 'Shop' },
	...(keeper ? [{ depth: 2, slug: 'keeper', text: 'Shopkeeper' }] : []),
	...(stock.length > 0 ? [{ depth: 2, slug: 'stock', text: 'Stock' }] : []),
	...(shop.notes ? [{ depth: 2, slug: 'notes', text: 'Notes' }] : []),
	...(shop.changes.length > 0 ? [{ depth: 2, slug: 'history', text: 'History' }] : []),
];
---

<StarlightPage
	frontmatter={{
		title: shop.name,
		description: `${shop.name}, a shop in MapleStory Classic World: who runs it, where it is, and what it sells.`,
		editUrl,
		scene: resolved.scene,
		mood: resolved.mood,
		subtitle: shop.region ? `${shop.region}.` : 'Region unknown.',
	}}
	headings={headings}
>
	<Window title="Shop" id="stats" build={shop.verified.build}>
		<StatRows rows={statisticRows} editUrl={editUrl} subject="this shop" />
	</Window>

	{
		keeperCard && (
			<Window title="Shopkeeper" id="keeper">
				<ol class="library-grid not-content">
					<LibraryCard card={{ ...keeperCard, fact: 'Runs this shop' }} />
				</ol>
			</Window>
		)
	}

	{
		stock.length > 0 && (
			<Window title="Stock" id="stock">
				<p class="window__note">Prices are not listed yet. Add them if you have checked in game.</p>
				<ol class="library-grid not-content">
					{stockCards.map((card) => (
						<LibraryCard card={card} />
					))}
				</ol>
			</Window>
		)
	}

	{
		shop.notes && (
			<Window title="Notes" id="notes">
				<p>{shop.notes}</p>
			</Window>
		)
	}

	{shop.changes.length > 0 && <ChangeLog collectionName="shops" entityIdentifier={shop.id} />}

	<SourceCredit sources={[shop.source_page]} />
</StarlightPage>
