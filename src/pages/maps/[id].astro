---
/*
   One page per map, generated from data/maps/ (spec 0004), in the same
   layout as the monster pages. The page sits in its region's hub scene
   when the region names one, or the scene its data names, or the default
   scene.

   The Map window opens with the map's minimap when one exists (decision
   0010), then lists the kind of map, its town, linked to the place
   page when the town has one, the region, and the recommended levels.
   Then what is there (spec 0007): the monsters and NPCs as inventory
   cards with their sprites, and the shops. Then the way around (spec
   0009): the maps its portals lead to, and the maps that lead here, as
   cards with their town's painted scene, so a reader can walk the world
   from page to page. Hidden portals are marked. Missing values read Unknown,
   and when every value is Unknown one invitation replaces the per row
   links. Notes and the history follow. Every value comes from
   the map's data file.

   The History window appears only once the entry has a recorded change.
*/
import { existsSync, readFileSync } from 'node:fs';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import { editBaseUrl } from '../../../site.config.mjs';
import ChangeLog from '../../components/ChangeLog.astro';
import SourceCredit from '../../components/SourceCredit.astro';
import StatRows from '../../components/StatRows.astro';
import LibraryCard from '../../components/LibraryCard.astro';
import Window from '../../components/Window.astro';
import { libraryCards, mapKindLabels } from '../../lib/library';
import { placeForTown } from '../../lib/places';
import { resolveMapScene } from '../../lib/scenes';

export async function getStaticPaths() {
	const mapEntries = await getCollection('maps');
	return mapEntries.map((mapEntry) => ({
		params: { id: mapEntry.data.id },
		props: { map: mapEntry.data },
	}));
}

const { map } = Astro.props;
const resolved = await resolveMapScene(map);
const editUrl = `${editBaseUrl}data/maps/${map.id}.yaml`;
const allCards = await libraryCards();
const npcIdsHere = new Set(
	(await getCollection('npcs')).map((npcEntry) => npcEntry.data).filter((npc) => npc.map === map.id).map((npc) => npc.id)
);
const monsterCards = allCards.filter((card) => card.type === 'monster' && map.monsters.includes(card.identifier));
const npcCards = allCards.filter((card) => card.type === 'npc' && npcIdsHere.has(card.identifier));
const shopsHere = (await getCollection('shops'))
	.map((shopEntry) => shopEntry.data)
	.filter((shop) => shop.map === map.id || (shop.npc !== undefined && npcIdsHere.has(shop.npc)))
	.sort((first, second) => first.name.localeCompare(second.name));
/*
   The minimap's size, read from the PNG header so the page never shifts
   while it loads (decision 0010).
*/
function readMinimap(file: string | undefined) {
	if (!file) return undefined;
	const filePath = `public/${file}`;
	if (!existsSync(filePath)) return undefined;
	const header = readFileSync(filePath).subarray(16, 24);
	return { source: `/${file}`, width: header.readUInt32BE(0), height: header.readUInt32BE(4) };
}

const minimap = readMinimap(map.minimap?.file);
const allMaps = (await getCollection('maps')).map((mapEntry) => mapEntry.data);
const exitTargets = new Set(map.exits.map((exit) => exit.to));
const hiddenExits = new Set(map.exits.filter((exit) => exit.kind === 'hidden').map((exit) => exit.to));
const exitCards = allCards
	.filter((card) => card.type === 'map' && exitTargets.has(card.identifier))
	.map((card) => (hiddenExits.has(card.identifier) ? { ...card, fact: `Hidden portal. ${card.fact}` } : card));
const entranceIds = new Set(
	allMaps.filter((other) => other.id !== map.id && other.exits.some((exit) => exit.to === map.id) && !exitTargets.has(other.id)).map((other) => other.id)
);
const entranceCards = allCards.filter((card) => card.type === 'map' && entranceIds.has(card.identifier));
const townName = map.town ?? (map.kind === 'town' ? map.name : undefined);
const townPlace = placeForTown(townName);

const placeLine = [townName && townName !== map.name ? `Near ${townName}` : undefined, map.region].filter(Boolean).join(', ');
const subtitle = placeLine ? `${placeLine}.` : 'Region unknown.';

const statisticRows = [
	{ label: 'Kind', value: map.kind ? mapKindLabels[map.kind] : undefined },
	{ label: 'Town', value: townName, href: townPlace ? `/places/${townPlace}/` : undefined },
	{ label: 'Region', value: map.region },
	{
		label: 'Recommended level',
		value: map.recommended_level ? `${map.recommended_level[0]} to ${map.recommended_level[1]}` : undefined,
	},
];

const headings = [
	{ depth: 2, slug: 'stats', text: 'Map' },
	...(exitCards.length > 0 ? [{ depth: 2, slug: 'exits', text: 'Exits' }] : []),
	...(entranceCards.length > 0 ? [{ depth: 2, slug: 'ways-in', text: 'Ways in' }] : []),
	...(monsterCards.length > 0 ? [{ depth: 2, slug: 'monsters', text: 'Monsters' }] : []),
	...(npcCards.length > 0 ? [{ depth: 2, slug: 'npcs', text: 'NPCs' }] : []),
	...(shopsHere.length > 0 ? [{ depth: 2, slug: 'shops', text: 'Shops' }] : []),
	...(map.notes ? [{ depth: 2, slug: 'notes', text: 'Notes' }] : []),
	...(map.changes.length > 0 ? [{ depth: 2, slug: 'history', text: 'History' }] : []),
];
---

<StarlightPage
	frontmatter={{
		title: map.name,
		description: `${map.name} in MapleStory Classic World: region, levels, monsters, and changes between builds.`,
		editUrl,
		scene: resolved.scene,
		mood: resolved.mood,
		subtitle,
	}}
	headings={headings}
>
	<Window title="Map" id="stats" build={map.verified.build}>
		{
			minimap && (
				<figure class="map-minimap">
					<img src={minimap.source} width={minimap.width} height={minimap.height} alt={`Minimap of ${map.name}`} decoding="async" />
					<figcaption>Minimap</figcaption>
				</figure>
			)
		}
		<StatRows rows={statisticRows} editUrl={editUrl} subject="this map" />
		{map.verified.build === 'cot2' && <p class="window__note">These numbers were seen in the closed beta. They may differ at launch.</p>}
	</Window>

	{
		exitCards.length > 0 && (
			<Window title="Exits" id="exits">
				<p class="window__note">Where the portals here lead.</p>
				<ol class="library-grid not-content">
					{exitCards.map((card) => (
						<LibraryCard card={card} />
					))}
				</ol>
			</Window>
		)
	}

	{
		entranceCards.length > 0 && (
			<Window title="Ways in" id="ways-in">
				<p class="window__note">Maps with a portal to here that this map does not lead back to.</p>
				<ol class="library-grid not-content">
					{entranceCards.map((card) => (
						<LibraryCard card={card} />
					))}
				</ol>
			</Window>
		)
	}

	{
		monsterCards.length > 0 && (
			<Window title="Monsters" id="monsters">
				<ol class="library-grid not-content">
					{monsterCards.map((card) => (
						<LibraryCard card={card} />
					))}
				</ol>
			</Window>
		)
	}

	{
		npcCards.length > 0 && (
			<Window title="NPCs" id="npcs">
				<ol class="library-grid not-content">
					{npcCards.map((card) => (
						<LibraryCard card={card} />
					))}
				</ol>
			</Window>
		)
	}

	{
		shopsHere.length > 0 && (
			<Window title="Shops" id="shops">
				<ul class="link-list">
					{shopsHere.map((shop) => (
						<li>
							<a href={`/shops/${shop.id}/`}>{shop.name}</a>
						</li>
					))}
				</ul>
			</Window>
		)
	}

	{
		map.notes && (
			<Window title="Notes" id="notes">
				<p>{map.notes}</p>
			</Window>
		)
	}

	{map.changes.length > 0 && <ChangeLog collectionName="maps" entityIdentifier={map.id} />}

	<SourceCredit sources={[map.source_page]} />
</StarlightPage>
