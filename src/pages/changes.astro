---
/*
   The version-aware heart of the site: the list of builds, official patch
   notes, then every recorded value change, newest build first.

   Each part sits in its own window, with heading ids the table of
   contents points at. The builds table has three columns, so on a phone
   each build becomes a small labeled block instead of scrolling. An
   empty window shows the same invitation box as every other window with
   no data.
*/
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import ChangeLog from '../components/ChangeLog.astro';
import Invitation from '../components/Invitation.astro';
import Window from '../components/Window.astro';
import { defaultBranch, repositoryUrl } from '../../site.config.mjs';
import { getBuildsNewestFirst } from '../lib/data';

const builds = await getBuildsNewestFirst();
const patches = (await getCollection('patches'))
	.map((patchEntry) => patchEntry.data)
	.sort((first, second) => second.date.getTime() - first.date.getTime());

const patchFolderUrl = `${repositoryUrl}/tree/${defaultBranch}/data/patches`;
const dateFormatter = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });
---

<StarlightPage
	frontmatter={{
		title: 'What changed',
		scene: 'harbor-board',
		subtitle: 'The harbor notice board.',
		description: 'Patch notes and value changes between builds of MapleStory Classic World.',
	}}
	headings={[
		{ depth: 2, slug: 'builds', text: 'Builds' },
		{ depth: 2, slug: 'patch-notes', text: 'Patch notes' },
		{ depth: 2, slug: 'value-changes', text: 'Value changes' },
	]}
>
	<Window title="Builds" id="builds">
		<table class="data-table data-table--stack">
			<thead>
				<tr><th scope="col">Build</th><th scope="col">Id</th><th scope="col">Date</th></tr>
			</thead>
			<tbody>
				{
					builds.map((build) => (
						<tr>
							<th scope="row">{build.name}</th>
							<td data-label="Id">
								<code>{build.id}</code>
							</td>
							<td data-label="Date">{dateFormatter.format(build.date)}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</Window>

	<Window title="Patch notes" id="patch-notes">
		{
			patches.length === 0 ? (
				<Invitation
					message="No patch notes recorded yet. Seen an official post? Link it here."
					href={patchFolderUrl}
					action="Add patch notes"
				/>
			) : (
				<ul class="patch-list">
					{patches.map((patch) => (
						<li>
							<a href={patch.source} rel="noopener">
								{patch.name}
							</a>
							, {dateFormatter.format(patch.date)}
							{patch.summary && <p>{patch.summary}</p>}
						</li>
					))}
				</ul>
			)
		}
	</Window>

	<ChangeLog />
</StarlightPage>
