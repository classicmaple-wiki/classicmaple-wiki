---
/*
   One page per monster, generated from data/monsters/. The edit link
   points at the YAML file, so fixing a number is one click away.

   The page sits in the scene of the first map that lists the monster, or
   in the default scene with the monster's own mood. The subtitle says
   where it lives, or plainly that nobody knows yet.

   Reports that differ from the original game come first, in a lead
   window titled Not the original, set apart from the facts. The title is
   short so it stays on one line on a phone. Then the Monster window with
   every stat as a labeled row, the drops players observed, labeled as
   community estimates with the kills behind each, and the history. A page
   built from MapleClassic Wiki data ends with its source credit (spec 0005). Missing values read
   Unknown. When every value is Unknown, one invitation replaces the per
   row links. The status chip sits in the title panel, which finds it by
   the page's path, so it is not repeated here. The table of contents
   lists exactly the windows shown.
*/
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import { editBaseUrl } from '../../../site.config.mjs';
import ChangeLog from '../../components/ChangeLog.astro';
import SourceCredit from '../../components/SourceCredit.astro';
import StatRows from '../../components/StatRows.astro';
import Window from '../../components/Window.astro';
import { formatList, formatStatistic } from '../../lib/data';
import { resolveMonsterScene } from '../../lib/scenes';

export async function getStaticPaths() {
	const monsterEntries = await getCollection('monsters');
	return monsterEntries.map((monsterEntry) => ({
		params: { id: monsterEntry.data.id },
		props: { monster: monsterEntry.data },
	}));
}

const { monster } = Astro.props;

const allMaps = (await getCollection('maps')).map((mapEntry) => mapEntry.data);
const mapNames = allMaps
	.filter((map) => map.monsters.includes(monster.id) || map.id === monster.location)
	.map((map) => map.name)
	.sort((first, second) => first.localeCompare(second));
const itemNames = new Map((await getCollection('items')).map((itemEntry) => [itemEntry.data.id, itemEntry.data.name]));

/*
   A drop rate reads best as "about 1 in N" next to the percentage, the way
   players talk about drops. Both come from the same observed share.
*/
function oneIn(ratePercent: number): string {
	if (ratePercent <= 0) return 'Not seen';
	return `about 1 in ${Math.max(1, Math.round(100 / ratePercent))}`;
}

const sortedDrops = [...monster.drops].sort((first, second) => second.rate_percent - first.rate_percent);

const resolved = await resolveMonsterScene(monster);
const editUrl = `${editBaseUrl}data/monsters/${monster.id}.yaml`;
const subtitle =
	mapNames.length === 0 ? 'Place unknown. Add it if you have seen it.' : `Found in ${formatList(mapNames)}.`;

/*
   Known numbers keep the shared formatting. A missing number stays
   empty here, so the stat rows can show it as Unknown.
*/
function statisticValue(value: number | undefined): string | undefined {
	return value === undefined ? undefined : formatStatistic(value);
}

/*
   An empty list means nobody has recorded it yet, not that there is
   nothing, so it also stays empty and shows as Unknown. Known element
   names are capitalized for reading.
*/
function listValue(values: string[]): string | undefined {
	if (values.length === 0) return undefined;
	return formatList(values.map((value) => value.charAt(0).toUpperCase() + value.slice(1)));
}

const statisticRows = [
	{ label: 'Level', value: statisticValue(monster.level) },
	{ label: 'HP', value: statisticValue(monster.hp) },
	{ label: 'MP', value: statisticValue(monster.mp) },
	{ label: 'EXP', value: statisticValue(monster.exp) },
	{ label: 'Weak to', value: listValue(monster.weak_to) },
	{ label: 'Strong to', value: listValue(monster.strong_to) },
	{ label: 'Immune to', value: listValue(monster.immune_to) },
	{ label: 'Found in', value: mapNames.length === 0 ? undefined : formatList(mapNames) },
];

const headings = [
	...(monster.differs_from_original
		? [{ depth: 2, slug: 'differs-from-original', text: 'Not the original' }]
		: []),
	{ depth: 2, slug: 'stats', text: 'Monster' },
	...(monster.drops.length > 0 ? [{ depth: 2, slug: 'drops', text: 'Drops' }] : []),
	...(monster.notes ? [{ depth: 2, slug: 'notes', text: 'Notes' }] : []),
	{ depth: 2, slug: 'history', text: 'History' },
];
---

<StarlightPage
	frontmatter={{
		title: monster.name,
		description: `${monster.name} in MapleStory Classic World: level, HP, EXP, weaknesses, and changes between builds.`,
		editUrl,
		scene: resolved.scene,
		mood: resolved.mood,
		subtitle,
	}}
	headings={headings}
>
	{
		monster.differs_from_original && (
			<div class="lead-window">
				<Window title="Not the original" id="differs-from-original">
					<blockquote>
						<p>{monster.differs_from_original}</p>
					</blockquote>
					<p class="lead-window__note">
						This is a lead, not a fact. <a href={editUrl}>Add the real value</a>
					</p>
				</Window>
			</div>
		)
	}

	<Window title="Monster" id="stats" build={monster.verified.build}>
		<StatRows rows={statisticRows} editUrl={editUrl} subject="this monster" />
	</Window>

	{
		sortedDrops.length > 0 && (
			<Window title="Drops" id="drops" build={sortedDrops[0].build}>
				<p class="window__note">
					Community estimates from player observations, not official rates. Each shows the kills it is based on.
				</p>
				<div class="window__scroll" tabindex="0" role="region" aria-label="Drops, scrolls sideways">
					<table class="data-table">
						<thead>
							<tr>
								<th scope="col">Item</th>
								<th scope="col">Rate</th>
								<th scope="col">Amount</th>
								<th scope="col">Based on</th>
							</tr>
						</thead>
						<tbody>
							{sortedDrops.map((monsterDrop) => (
								<tr>
									<th scope="row">
										{monsterDrop.item === 'meso' ? (
											'Mesos'
										) : (
											<a href={`/items/${monsterDrop.item}/`}>{itemNames.get(monsterDrop.item) ?? monsterDrop.item}</a>
										)}
									</th>
									<td>
										{oneIn(monsterDrop.rate_percent)} ({monsterDrop.rate_percent}%)
									</td>
									<td>{monsterDrop.quantity ? `${monsterDrop.quantity[0]} to ${monsterDrop.quantity[1]}` : '1'}</td>
									<td>
										{monsterDrop.sample_kills} kills, <time datetime={monsterDrop.observed_on.toISOString().slice(0, 10)}>{monsterDrop.observed_on.toISOString().slice(0, 10)}</time>
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</Window>
		)
	}

	{
		monster.notes && (
			<Window title="Notes" id="notes">
				<p>{monster.notes}</p>
			</Window>
		)
	}

	<ChangeLog collectionName="monsters" entityIdentifier={monster.id} />

	<SourceCredit sources={[monster.source_page, ...sortedDrops.map((monsterDrop) => monsterDrop.source)]} />
</StarlightPage>
