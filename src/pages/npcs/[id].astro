---
/*
   One page per NPC, generated from data/npcs/ (spec 0005), in the same
   layout as the map pages. The NPC window gives the role, the map the NPC
   stands on, and the region, then the quests the NPC gives or takes and
   the shop the NPC runs, each linked to its own page. Missing values read
   Unknown. Notes, the history, and the source credit follow.

   The History window appears only once the entry has a recorded change.
*/
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import { editBaseUrl } from '../../../site.config.mjs';
import ChangeLog from '../../components/ChangeLog.astro';
import SourceCredit from '../../components/SourceCredit.astro';
import StatRows from '../../components/StatRows.astro';
import Window from '../../components/Window.astro';
import { placeForTown } from '../../lib/places';
import { resolveMapScene } from '../../lib/scenes';

export async function getStaticPaths() {
	const npcEntries = await getCollection('npcs');
	return npcEntries.map((npcEntry) => ({
		params: { id: npcEntry.data.id },
		props: { npc: npcEntry.data },
	}));
}

const { npc } = Astro.props;
const editUrl = `${editBaseUrl}data/npcs/${npc.id}.yaml`;
const standingMap = (await getCollection('maps')).find((mapEntry) => mapEntry.data.id === npc.map)?.data;
const resolved = await resolveMapScene(standingMap ?? npc);
const npcTown = standingMap?.town ?? (standingMap?.kind === 'town' ? standingMap.name : undefined);
const npcPlace = placeForTown(npcTown);
const relatedQuests = (await getCollection('quests'))
	.map((questEntry) => questEntry.data)
	.filter((quest) => quest.giver === npc.id || quest.turn_in === npc.id)
	.sort((first, second) => first.name.localeCompare(second.name));
const runShops = (await getCollection('shops'))
	.map((shopEntry) => shopEntry.data)
	.filter((shop) => shop.npc === npc.id);

const statisticRows = [
	...(npc.role ? [{ label: 'Role', value: npc.role }] : []),
	{ label: 'Map', value: standingMap?.name, href: standingMap ? `/maps/${standingMap.id}/` : undefined },
	{ label: 'Town', value: npcTown, href: npcPlace ? `/places/${npcPlace}/` : undefined },
	{ label: 'Region', value: npc.region },
];

const headings = [
	{ depth: 2, slug: 'stats', text: 'NPC' },
	...(relatedQuests.length > 0 || runShops.length > 0 ? [{ depth: 2, slug: 'links', text: 'Quests and shops' }] : []),
	...(npc.notes ? [{ depth: 2, slug: 'notes', text: 'Notes' }] : []),
	...(npc.changes.length > 0 ? [{ depth: 2, slug: 'history', text: 'History' }] : []),
];
---

<StarlightPage
	frontmatter={{
		title: npc.name,
		description: `${npc.name}, an NPC in MapleStory Classic World: where to find them, their quests, and their shop.`,
		editUrl,
		scene: resolved.scene,
		mood: resolved.mood,
		subtitle: npc.region ? `${npc.region}.` : 'Region unknown. Add it if you have met them.',
	}}
	headings={headings}
>
	<Window title="NPC" id="stats" build={npc.verified.build}>
		<StatRows rows={statisticRows} editUrl={editUrl} subject="this NPC" />
	</Window>

	{
		(relatedQuests.length > 0 || runShops.length > 0) && (
			<Window title="Quests and shops" id="links">
				<ul class="link-list">
					{runShops.map((shop) => (
						<li>
							Runs <a href={`/shops/${shop.id}/`}>{shop.name}</a>
						</li>
					))}
					{relatedQuests.map((quest) => (
						<li>
							{quest.giver === npc.id && quest.turn_in === npc.id
								? 'Gives and takes'
								: quest.giver === npc.id
									? 'Gives'
									: 'Takes'}{' '}
							<a href={`/quests/${quest.id}/`}>{quest.name}</a>
						</li>
					))}
				</ul>
			</Window>
		)
	}

	{
		npc.notes && (
			<Window title="Notes" id="notes">
				<p>{npc.notes}</p>
			</Window>
		)
	}

	{npc.changes.length > 0 && <ChangeLog collectionName="npcs" entityIdentifier={npc.id} />}

	<SourceCredit sources={[npc.source_page]} />
</StarlightPage>
