---
/*
   One page per quest, generated from data/quests/ (spec 0005), in the
   same layout as the map pages. The Quest window gives who starts the
   quest, who finishes it, the region, and the quests that must come
   first, each linked to its own page, then the quests this one opens.
   Rewards and requirements are left out until a player confirms them.
   Notes, the history, and the source credit follow.

   The History window appears only once the entry has a recorded change.
*/
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import { editBaseUrl } from '../../../site.config.mjs';
import ChangeLog from '../../components/ChangeLog.astro';
import SourceCredit from '../../components/SourceCredit.astro';
import StatRows from '../../components/StatRows.astro';
import Window from '../../components/Window.astro';
import { formatList } from '../../lib/data';
import { resolveMapScene } from '../../lib/scenes';

export async function getStaticPaths() {
	const questEntries = await getCollection('quests');
	return questEntries.map((questEntry) => ({
		params: { id: questEntry.data.id },
		props: { quest: questEntry.data },
	}));
}

const { quest } = Astro.props;
const resolved = await resolveMapScene(quest);
const editUrl = `${editBaseUrl}data/quests/${quest.id}.yaml`;
const npcsById = new Map((await getCollection('npcs')).map((npcEntry) => [npcEntry.data.id, npcEntry.data]));
const allQuests = (await getCollection('quests')).map((questEntry) => questEntry.data);
const questsById = new Map(allQuests.map((otherQuest) => [otherQuest.id, otherQuest]));
const giver = quest.giver ? npcsById.get(quest.giver) : undefined;
const turnIn = quest.turn_in ? npcsById.get(quest.turn_in) : undefined;
const prerequisites = quest.prerequisites.flatMap((identifier) => questsById.get(identifier) ?? []);
const opens = allQuests
	.filter((otherQuest) => otherQuest.prerequisites.includes(quest.id))
	.sort((first, second) => first.name.localeCompare(second.name));

const statisticRows = [
	{ label: 'Starts with', value: giver?.name, href: giver ? `/npcs/${giver.id}/` : undefined },
	{ label: 'Ends with', value: turnIn?.name, href: turnIn ? `/npcs/${turnIn.id}/` : undefined },
	{ label: 'Region', value: quest.region },
	{
		label: 'Comes after',
		value: prerequisites.length === 0 ? 'Nothing' : formatList(prerequisites.map((prerequisite) => prerequisite.name)),
	},
];

const headings = [
	{ depth: 2, slug: 'stats', text: 'Quest' },
	...(prerequisites.length > 0 || opens.length > 0 ? [{ depth: 2, slug: 'chain', text: 'Quest chain' }] : []),
	...(quest.notes ? [{ depth: 2, slug: 'notes', text: 'Notes' }] : []),
	...(quest.changes.length > 0 ? [{ depth: 2, slug: 'history', text: 'History' }] : []),
];
---

<StarlightPage
	frontmatter={{
		title: quest.name,
		description: `${quest.name}, a quest in MapleStory Classic World: who starts it, who ends it, and what comes before and after.`,
		editUrl,
		scene: resolved.scene,
		mood: resolved.mood,
		subtitle: quest.region ? `${quest.region}.` : 'Region unknown. Add it if you have done it.',
	}}
	headings={headings}
>
	<Window title="Quest" id="stats" build={quest.verified.build}>
		<StatRows rows={statisticRows} editUrl={editUrl} subject="this quest" />
	</Window>

	{
		(prerequisites.length > 0 || opens.length > 0) && (
			<Window title="Quest chain" id="chain">
				<ul class="link-list">
					{prerequisites.map((prerequisite) => (
						<li>
							Before this: <a href={`/quests/${prerequisite.id}/`}>{prerequisite.name}</a>
						</li>
					))}
					{opens.map((nextQuest) => (
						<li>
							After this: <a href={`/quests/${nextQuest.id}/`}>{nextQuest.name}</a>
						</li>
					))}
				</ul>
			</Window>
		)
	}

	{
		quest.notes && (
			<Window title="Notes" id="notes">
				<p>{quest.notes}</p>
			</Window>
		)
	}

	{quest.changes.length > 0 && <ChangeLog collectionName="quests" entityIdentifier={quest.id} />}

	<SourceCredit sources={[quest.source_page]} />
</StarlightPage>
